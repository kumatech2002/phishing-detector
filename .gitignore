# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment secrets — NEVER commit real secrets
backend/.env

# Generated model artifacts (regenerate with train.py)
backend/models/*.joblib
backend/models/meta.json

# Dataset (regenerate with dataset.py)
backend/data/dataset.csv

# Database
backend/db/*.db
backend/db/*.db-shm
backend/db/*.db-wal

# Logs
backend/logs/*.log

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# pytest cache
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Gitkeep files (track empty dirs)
!backend/models/.gitkeep
!backend/logs/.gitkeep
