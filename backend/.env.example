# Environment variables for Phishing Detector
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# Flask secret key — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Path to SQLite database file (relative to backend/)
DATABASE_PATH=db/phishing.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rate limiting for /api/analyze endpoint
RATE_LIMIT=30 per minute

# Set to 'production' to disable debug mode and enable secure headers
FLASK_ENV=development
